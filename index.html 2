<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>My Private Site</title>

<style>
body{
  margin:0;
  background:#111;
  color:white;
  font-family:sans-serif;
  text-align:center;
}

/* 上のタイトル */
header{
  padding:20px;
  font-size:24px;
  font-weight:bold;
}

/* メニューリンク */
nav{
  margin-bottom:20px;
}

nav a{
  color:white;
  text-decoration:none;
  margin:0 10px;
  padding:8px 12px;
  border:1px solid #444;
  border-radius:8px;
  display:inline-block;
}

nav a:hover{
  background:#333;
}

/* ギャラリー部分 */
.gallery{
  display:grid;
  grid-template-columns: repeat(auto-fit, minmax(150px,1fr));
  gap:10px;
  padding:10px;
}

.gallery img, .gallery video{
  width:100%;
  border-radius:10px;
}
</style>

</head>

<body>

<header>
📁 My Private Hub
</header>

<!-- 🔗 ページ移動メニュー -->
<nav>
  <a href="index.html">🏠 Home</a>
  <a href="video.html">🎬 Videos</a>
</nav>

<!-- 📸 写真＋動画ギャラリー -->
<div class="gallery">

  <!-- 画像 -->
  <img src="images/photo1.jpg" alt="photo1">
  <img src="images/photo2.jpg" alt="photo2">

  <!-- 動画（ホームにも少しだけ表示） -->
  <video controls>
    <source src="videos/movie1.mp4" type="video/mp4">
  </video>

</div>

</body>
</html>
